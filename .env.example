# ---------------------------------------------------------------------------
# Firebase — the four required values come from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#
# These are *not* secrets. Every Firebase web client ships them. What keeps
# your data safe is firebase/firestore.rules, which you must deploy.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
# Set this to the domain the app is SERVED from, not the default
# your-project.firebaseapp.com that the Firebase console hands you.
#
# Safari and iOS block the cross-origin storage that Firebase Auth uses to
# hand a credential back, so if this differs from the app's own origin, signing
# in with Google appears to work and returns the visitor still signed out.
# Every Firebase Hosting domain in the project serves the /__/auth/ endpoints
# needed for this, so same-origin is the right answer for a hosted app.
VITE_FIREBASE_AUTH_DOMAIN=your-project.web.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------------------
# TURN relay (optional).
#
# Leave blank and most players will connect fine, peer to peer. Players behind
# a strict NAT — some corporate networks, some mobile carriers — cannot, and
# need a relay. Any TURN provider works; the lobby reports a clear failure
# rather than hanging when a connection is impossible.
# ---------------------------------------------------------------------------
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
