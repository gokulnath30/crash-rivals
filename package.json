{
  "name": "arcade-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A two-player browser game store: Google sign-in, invite links, WebRTC matches.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css}\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "firebase": "^12.18.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
